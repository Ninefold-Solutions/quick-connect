<% if defined?(message) && !message.nil? %>
  <%= render "shared/success_message", message: message %>
<% end %>

<div class="flex space-x-4 py-4">
  <div
    class="flex-1 min-w-0"
    data-behavior="autocomplete"
    data-controller="nav-search"
    data-nav-search-url-value="/search/add?batch_id=<%= batch.id %>"
  >
    <label for="search" class="block text-sm font-medium text-gray-700">Search To Add Contact</label>

    <div class="flex mt-1 relative rounded shadow-sm">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <!-- Heroicon name: solid/search -->
        <%= ui_icon(:magnifying_glass, classes: "h-5 w-5 text-gray-400") %>
      </div>

      <input
        type="search"
        name="search"
        id="search"
        class="block w-full pl-10 form-text-field"
        placeholder="Search"
        autocomplete="off"
        data-nav-search-target="input"
      >
    </div>

    <div class="relative">
      <div
        class="absolute left-0 z-10 block w-full mt-2 origin-top-right bg-white rounded shadow-lg focus:outline-none"
        role="menu"
        aria-orientation="vertical"
        aria-labelledby="options-menu"
      >
        <ul id="searched_contacts" data-nav-search-target="results"></ul>
      </div>
    </div>
  </div>
</div>
