<% show_social = batch.linkedin.present? or batch.twitter.present? or batch.website.present? or batch.jobboard.present? %>

<% if show_social %>
  <dt class="mb-2 font-semibold leading-none text-gray-900 text-sm">Social</dt>
  <dd class="flex items-center justify-start mb-4 sm:mb-5">
    <% if batch.jobboard.present? %>
      <a
        href="<%= batch.jobboard %>"
        target="_blank"
        data-controller="tooltip"
        data-tooltip-content="Job Board"
        class="icon-button"
      >
        <%= svg_icon("github-logo") %>
        <span class="sr-only">Job Board</span>
      </a>
    <% end %>

    <% if batch.twitter.present? %>
      <a
        href="<%= batch.twitter %>"
        target="_blank"
        data-controller="tooltip"
        data-tooltip-content="Twitter profile"
        class="icon-button"
      >
        <%= svg_icon("twitter-logo") %>
        <span class="sr-only">Twitter</span>
      </a>
    <% end %>

    <% if batch.website.present? %>
      <a
        href="<%= batch.website %>"
        target="_blank"
        data-controller="tooltip"
        data-tooltip-content="Website"
        class="icon-button"
      >
        <%= svg_icon("globe") %>
        <span class="sr-only">Website</span>
      </a>
    <% end %>

    <% if batch.linkedin.present? %>
      <a
        href="<%= absolute_url(batch.linkedin) %>"
        target="_blank"
        class="icon-button"
        data-controller="tooltip"
        data-tooltip-content="Linkedin Profile"
      >
        <%= svg_icon("linkedin-logo") %>
        <span class="sr-only">Linkedin</span>
      </a>
    <% end %>
  </dd>
<% end %>
