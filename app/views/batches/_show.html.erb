<% if !batch.blank? %>
  <div
    class="border-r border-gray-200 h-full"
    id="show"
    data-controller="confirmation-fetch"
    data-confirmation-fetch-target="replace"
  >
    <!-- Sidebar component, swap this element with another sidebar if you like -->
    <section aria-labelledby="participants_section">
      <div class="overflow-hidden bg-white h-screen min-h-full max-content top-16 overflow-y-scroll overscroll-contain">
        <div class="px-4 sm:px-6 pt-4">
          <div class="flex items-center justify-between">
            <div class="flex flex-wrap items-baseline">
              <div class="flex flex-wrap items-baseline" style="width: 20.2rem;">
                <h1 class="text-3xl font-bold leading-tight text-gray-900 truncate .."><%= batch.name %></h1>
                <% if batch.website.to_s.strip.present? %>
                  <a href="<%= ensure_protocol(batch.website) %>" target="_blank" rel="noopener noreferrer" class="ml-2 text-blue-600 hover:text-blue-700" aria-label="Open group website">
                    <i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i>
                  </a>
                <% end %>
                <p class="mt-2 text-sm text-gray-600 mr-4 ml-1">(<%= contacts.count.to_s %>)</p>
              </div>

              <div class="mt-1 text-sm text-gray-600 pb-2">
                <p>Please add contacts to group.</p>
              </div>
            </div>
          </div>

          <div>
            <% if defined?(message) && !message.nil? %>
              <%= render "search", { batch: batch, message: message } %>
            <% else %>
              <%= render "search", { batch: batch } %>
            <% end %>

            <div class="relative px-6 h-full"></div>

            <nav class="flex-1 pt-4">
              <ul role="list" class="relative z-0 h-full pb-20" id="batch_contacts">
                <%= render "contact", { batch: batch, contacts: contacts } %>
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </section>
  </div>
<% end %>
