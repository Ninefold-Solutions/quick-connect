<% if !contact.blank? %>
  <% if policy(contact).profile? %>
    <div class="h-full" id="profile1">
      <div>
        <img
          class="h-32 w-full object-cover lg:h-48"
          src="https://images.unsplash.com/photo-1444628838545-ac4016a5418a?ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80"
          alt=""
        >
      </div>

      <div class="mx-auto lg:px-6" id="contact-header">
        <div class="-mt-12 sm:-mt-16 sm:flex sm:items-end lg:space-x-5 md:space-x-3">
          <div class="flex">
            <%= image_tag "male-placeholder-image.png", class: "h-20 w-20 rounded-full ring-4 ring-white sm:h-32 sm:w-32" %>
          </div>

          <div class="sm:flex-1 sm:min-w-0 sm:flex sm:items-center justify-end lg:space-x-3">
            <div class="sm:hidden 2xl:block mt-4 min-w-0 flex-1">
              <h1 class="text-2xl font-bold text-gray-900 truncate"><%= contact.decorate.display_name %></h1>
            </div>

            <div
              id=""
              class="flex flex-col whitespace-nowrap justify-stretch space-y-1 sm:flex-row sm:space-y-0 space-x-4"
            >
              <label
                type="button"
                class="
                  inline-flex w-full justify-center gap-x-1.5 rounded px-3 py-2 text-sm font-semibold shadow-sm
                  ring-1 ring-inset ring-gray-300 bg-gray-100 text-gray-800 hover:bg-gray-50
                "
                id="menu-button"
                aria-expanded="true"
                aria-haspopup="true"
              >
                <%= contact.decorate.display_follow_up_after %>
              </label>

              <div class="inline-flex space-x-2">
                <% if !contact.links.empty? %>
                  <% contact.links.each do |link| %>
                    <label for="links" class="">
                      <a
                        href="<%= link.link %>"
                        data-contact-id="<%= contact.id %>"
                        target="_blank"
                        title="<%= link.link_type.split("-").last.upcase_first %>"
                        id="phone"
                      >
                        <!-- Heroicon name: solid/mail -->
                        <div
                          class="
                            h-9 bg-indigo-50 text-indigo-700 border-indigo-700 ring-1 ring-indigo-700 cursor-pointer
                            rounded-full w-9 grid place-content-center
                          "
                        >
                          <span class="">
                            <i class="<%= link.link_type %> font-medium fa-lg flex-auto"></i>
                          </span>
                        </div>
                      </a>

                      <span></span>
                    </label>
                  <% end %>
                <% end %>
              </div>

              <div>
                <a
                  type="button"
                  href="/<%= contact.account.id %>/contact/<%= contact.id %>/update_touched?batch_id=<%= group_id %>"
                  title="Mark As Touched"
                  data-controller="confirmation tooltip"
                  data-confirmation-message-value="Are you sure you want to mark as touched to this contact? Marking this as touched means you took a followup with this contact today."
                  data-action="confirmation#confirm"
                  data-tooltip-content="Mark As Touched"
                  class="cursor-pointer"
                >
                  <!-- Heroicon name: solid/mail -->
                  <span class="icon-span"><%= touched(5) %></span>
                </a>
              </div>

              <% if !contact.phone.blank? %>
                <div>
                  <button type="button" title="Send Sms">
                    <!-- Heroicon name: solid/mail -->
                    <span class="icon-span">
                      <i class="fa-solid fa-comments h-5 w-5"></i>
                    </span>
                  </button>
                </div>
              <% end %>

              <% if !contact.email.blank? %>
                <div>
                  <a type="button" href="mailto:<%= contact.email %>" title="Send Email">
                    <!-- Heroicon name: solid/mail -->
                    <span class="icon-span">
                      <i class="fa-solid fa-envelope h-5 w-5"></i>
                    </span>
                  </a>
                </div>
              <% end %>

              <a
                href="/<%= contact.account.id %>/contacts/<%= contact.id %>/timeline"
                type="button"
                class="btn-secondary inline-flex whitespace-nowrap"
              >
                View Profile
              </a>
            </div>
          </div>
        </div>

        <div></div>

        <div class="hidden sm:block 2xl:hidden mt-4 min-w-0 flex-1">
          <h1 class="text-2xl font-bold text-gray-900"><%= contact.decorate.display_name %></h1>
        </div>
      </div>

      <div class="py-2 px-6 flex">
        <% if contact.intro? %>
          <p class="text-sm font-medium text-gray-500" style="flex-shrink: 2 ">
            <%= contact.intro.upcase_first %>
          </p>
        <% end %>
      </div>

      <!-- Tabs -->
      <div class="mt-6 sm:mt-2 2xl:mt-5">
        <div class="border-b border-gray-200">
          <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="-mb-px flex space-x-8" aria-label="Tabs">
              <!-- Current: "border-indigo-500 text-gray-900", Default: "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300" -->
              <button
                class="border-indigo-500 text-gray-900 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"
                aria-current="page"
              >
                Profile
              </button>
            </nav>
          </div>
        </div>
      </div>

      <!-- Description list -->
      <div class="mt-6 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <dl class="grid grid-cols-1 gap-x-4 gap-y-8 sm:grid-cols-3">
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Phone</dt>

            <% if !contact.phone.blank? %>
              <dd class="mt-1 text-sm text-gray-900"><%= contact.phone %></dd>
            <% else %>
              <dd class="text-xs font-normal text-gray-500 mt-1">-</dd>
            <% end %>
          </div>

          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Email</dt>

            <% if !contact.email.blank? %>
              <dd class="mt-1 text-sm text-gray-900 break-words"><%= contact.decorate.display_email %></dd>
            <% else %>
              <dd class="text-xs font-normal text-gray-500 mt-1">-</dd>
            <% end %>
          </div>
        </dl>
      </div>

      <!-- Team member list -->
      <div class="mt-8 max-w-5xl mx-auto px-4 pb-12 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 gap-16">
          <div class="grid grid-cols-1 col-span-2">
            <div>
              <h2 class="text-sm font-medium text-gray-500 pb-2">Last Activities</h2>

              <ul class="mt-1">
                <% contact.events.sanitize.limit(5).each do |event| %>
                  <% if lookup_context.template_exists?(event.action, "dashboard", true) %>
                    <% cache event do %>
                      <%= render partial: "contact/timeline/#{event.action}", locals: { event: event } %>
                    <% end %>
                  <% end %>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
