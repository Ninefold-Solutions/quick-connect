<%= form_with(model: batch, id: dom_id(batch), url: batches_path) do |form| %>
  <%= render "shared/form_messages", resource: batch, message: local_assigns[:message] %>

  <div class="flex">
    <div class="flex-1 min-w-0">
      <%= form.label :name, "Add New Group", class: "block text-sm font-medium text-gray-700 pt-4" %>

      <div class="flex py-2">
        <div class="flex-1"><%= form.text_field :name, autocomplete: "off", class: "form-text-field" %></div>
        <div class="flex justify-end space-x-2"><%= form.submit "Add", class: "btn-primary ml-2 " %></div>
      </div>
    </div>
  </div>
<% end %>
