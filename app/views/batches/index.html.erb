<main class="relative z-0 flex-1 overflow-x-hidden focus:outline-none bg-gray-50">
  <div class="min-h-full">
    <div class="flex flex-wrap items-baseline px-6 py-4">
                  <div class="flex flex-wrap items-baseline">
                    <h1 class="text-3xl font-bold leading-tight text-gray-900">Groups</h1>
                    <p class="mt-2 ml-1 text-sm text-gray-600 truncate">(<%= @batches.count %>)</p>
                  </div>
    </div>
    <div class="grid grid-cols-6 border-t px-1 border-gray-200">
      <%= render partial: "column", locals: { title: "Dormant", batches: @first, list_id: "first" } %>
    
      <%= render partial: "column", locals: { title: "Broad Buying", batches: @second, list_id: "second" } %>
  
      <%= render partial: "column", locals: { title: "Buying Window", batches: @third, list_id: "third" } %>
      <%= render partial: "column", locals: { title: "Conversations", batches: @fourth, list_id: "fourth" } %>
      <%= render partial: "column", locals: { title: "Meetings", batches: @fifth, list_id: "fifth" } %>
      <%= render partial: "column", locals: { title: "Contracts", batches: @sixth, list_id: "sixth" } %>
    </div>
  </div>
</main>
