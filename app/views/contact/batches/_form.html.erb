<%= form_with(id: "form", url: "/#{current_user.account.id}/contacts/#{contact.id}/groups") do |form| %>
  <div class="space-y-4 px-4 pt-4 mx-auto h-full">
    <% if local_assigns[:message] && defined?(message) && !message.nil? %>
      <div class="p-4 rounded bg-red-50" id="error_explanation">
        <div class="flex">
          <div class="flex-shrink-0">
            <!-- Heroicon name: solid/x-circle -->
            <i class="fa-solid fa-circle-xmark w-5 h-5 text-red-400" aria-hidden="true"></i>
          </div>

          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800">1 error prohibited this contact from being saved:</h3>

            <div class="mt-2 text-sm text-red-700">
              <ul class="pl-5 space-y-1 list-disc">
                <li><%= message %></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <%= render "shared/form_header", title: "Add Contact To Group", subtitle: "A contact can be added to a group which can help in organising similar contacts together." %>

    <div>
      <label for="group" class="block text-sm font-medium text-gray-700"> Select Group </label>

      <select class="form-text-field mt-1" name="batch_id" id="batch_id">
        <option value="">Select Group</option>

        <% if !groups.nil? %>
          <% groups.each do |group| %>
            <li>
              <option value="<%= group.id %>"><%= group.name %></option>
            </li>
          <% end %>
        <% end %>
      </select>
    </div>

    <div class="flex justify-end">
      <%= form.submit "Save", class: "btn-primary" %>
    </div>
  </div>
<% end %>
