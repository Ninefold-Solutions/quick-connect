<%= turbo_frame_tag dom_id(social) do %>
  <% if !social.id.nil? %>
    <li class="py-3">
      <div class="flex">
        <div class="flex justify-between space-x-26">
          <div class="text-sm text-gray-900 font-medium w-40">
            <a href="<%= social.link %>" target="_blank">
              <p class="ml-3 font-light text-gray-600 inline-flex">
                <span class="bg-black h-12 w-12 rounded-full place-content-center grid">
                  <%= social_icon_badge(social.normalized_link_type, classes: "font-semibold text-white text-sm") %>
                </span>

                <% if !social.link_type.nil? %>
                  <span class="flex-none mt-1 font-semibold pl-4"><%= social.link_type_label %></span>
                <% end %>
              </p>

              <p class="text-sm text-gray-900 font-light pl-16 ml-3 -mt-5"><%= social.link %></p>
            </a>
          </div>

          <div class="mt-2 space-x-2 text-sm inline-flex">
            <% if policy([social.contact, social]).edit? %>
              <%= edit_button("/#{social.contact.account.id}/contacts/#{social.contact.id}/links/#{social.id}/edit") %>
            <% end %>

            <% if policy([social.contact, social]).destroy? %>
              <%= delete_button("/#{social.contact.account.id}/contacts/#{social.contact.id}/links/#{social.id}") %>
            <% end %>
          </div>
        </div>
      </div>
    </li>
  <% end %>
<% end %>
