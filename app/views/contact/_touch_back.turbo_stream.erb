<% contact = contact.decorate %>

<button
  type="button"
  data-action="click->dropdown#toggle"
  class="
    inline-flex w-full justify-center gap-x-1.5 rounded px-3 py-2 text-sm font-semibold shadow-sm ring-1 ring-inset
    ring-gray-300 bg-gray-100 text-gray-800 hover:bg-gray-50
  "
  id="touch-back-button-<%= contact.id %>"
  aria-expanded="false"
  aria-haspopup="true"
>
  <%= contact.display_follow_up_after %>

  <i class="fa-solid fa-chevron-down -mr-1 h-5 w-5 text-gray-400" aria-hidden="true"></i>
</button>
