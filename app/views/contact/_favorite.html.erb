<ul class="flex list-none">
  <% if !contact.favorite? %>
    <li id="favorite">
      <a title="Favourite" data-controller="tooltip" data-tooltip-content="Mark As Favorite">
        <span class="icon-span" data-action="click->contact#toggle_favorite" data-contact-id="<%= contact.id %>">
          <i class="fa-regular fa-star h-4 w-4" aria-hidden="true"></i>
        </span>
      </a>
    </li>
  <% else %>
    <li id="not-favorite">
      <a title="not-favourite" data-controller="tooltip" data-tooltip-content="Remove As Favorite">
        <span class="icon-span" data-action="click->contact#toggle_favorite" data-contact-id="<%= contact.id %>">
          <i class="fa-solid fa-star h-4 w-4" aria-hidden="true"></i>
        </span>
      </a>
    </li>
  <% end %>
</ul>
