<ul class="flex list-none">
  <% if !contact.favorite? %>
    <li id="favorite">
      <button title="Favourite" data-controller="tooltip" data-tooltip-content="Mark As Favorite">
        <span class="icon-span" data-action="click->contact#toggle_favorite" data-contact-id="<%= contact.id %>">
          <%= ui_icon(:star_outline, classes: "h-4 w-4") %>
        </span>
      </button>
    </li>
  <% else %>
    <li id="not-favorite">
      <button title="not-favourite" data-controller="tooltip" data-tooltip-content="Remove As Favorite">
        <span class="icon-span" data-action="click->contact#toggle_favorite" data-contact-id="<%= contact.id %>">
          <%= ui_icon(:star_solid, classes: "h-4 w-4") %>
        </span>
      </button>
    </li>
  <% end %>
</ul>
