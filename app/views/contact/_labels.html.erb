<% if contact_labels.load.size > 0 %>
  <% contact_labels.uniq.each do |label| %>
    <% badge_classes = "inline-flex items-center gap-0.5 rounded-sm px-1.5 py-0.5 text-xs border font-medium ml-2 border-#{label.color}-200 bg-#{label.color}-100 text-#{label.color}-800" %>
    <% remove_button_classes = "ml-0.5 cursor-pointer flex-shrink-0 h-4 w-4 rounded-full inline-flex items-center justify-center leading-none text-#{label.color}-400 hover:bg-#{label.color}-200 hover:text-#{label.color}-400 focus:outline-none focus:bg-#{label.color}-400 focus:text-white" %>

    <div id="<%= dom_id(label) %>">
      <span class="<%= badge_classes %>">
        <span class="leading-none"><%= label.name.upcase_first %></span>

        <button
          id="remove"
          data-action="contact#remove_label"
          data-id="<%= label.id %>"
          data-contact-id="<%= contact.id %>"
          type="button"
          class="<%= remove_button_classes %>"
        >
          <i class="fa-solid fa-xmark fa-xs leading-none" aria-hidden="true"></i>
        </button>
      </span>
    </div>
  <% end %>
<% end %>

<% if policy(contact).edit? %>
  <div class="flex-auto ml-1" data-controller="dropdown">
    <button
      id="add"
      data-action="click->dropdown#toggle"
      type="button"
      class="
        inline-flex items-center p-1 ml-2 text-white bg-indigo-600 border border-transparent rounded-full shadow-sm
        hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500
      "
    >
      <!-- Heroicon name: solid/plus -->
      <i class="fa-solid fa-plus w-4 h-4" aria-hidden="true"></i>
    </button>

    <div
      data-dropdown-target="menu"
      id="labels-menu"
      class="hidden absolute z-10 w-56 mt-2 origin-top-right bg-white rounded shadow-lg focus:outline-none"
      role="menu"
      aria-orientation="vertical"
      aria-labelledby="menu-button"
      tabindex="-1"
    >
      <% if Label.all.order(:name).size == 0 %>
        <div class="py-1" role="none">
          <p data-action="click->dropdown#close" role="menuitem" class="block px-4 py-2 text-sm text-gray-700">
            No label added yet
          </p>

          <a
            href="<%= account_labels_path %>"
            class="block px-4 py-2 text-sm text-indigo-700 hover:bg-gray-50 hover:underline"
          >
            Add Labels
          </a>
        </div>
      <% else %>
        <% available_labels = labels - contact_labels %>
        <% if available_labels.size == 0 %>
          <div class="py-1" role="none" id="no_labels">
            <a
              data-action="click->dropdown#close"
              href="/<%= current_user.account_id %>/account/labels"
              role="menuitem"
              class="block px-4 py-2 text-sm text-indigo-700 hover:bg-gray-50 hover:underline"
            >
              Add Labels
            </a>
          </div>
        <% else %>
          <div class="py-1" role="none" id="labels">
            <% available_labels.each do |label| %>
              <!-- Active: "bg-gray-100 text-gray-900", Not Active: "text-gray-700" -->
              <button
                type="button"
                data-action="click->dropdown#close contact#add_label"
                class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"
                role="menuitem"
                data-contact-id="<%= contact.id %>"
                data-id="<%= label.id %>"
              >
                <%= label.name.upcase_first %>
              </button>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
