<% contact = contact.decorate %>

<li
  id="<%= dom_id(contact) %>"
  class="hover:bg-gray-50 focus-within:ring-2 focus-within:ring-inset focus-within:ring-indigo-500 <%= "bg-gray-100" if params[:contact_id].present? && params[:contact_id].to_i == contact.id %>"
>
  <a
    href="<%= collections_path(collection_id: params[:collection_id], batch_id: params[:batch_id], contact_id: contact.id) %>"
    class="block"
  >
    <div class="relative cursor-pointer px-2 py-3 flex space-x-2" id="show" data-contact-id="<%= contact.id %>">
      <div class="flex-shrink-0">
        <%= image_tag "male-placeholder-image.png", class: "w-10 h-10 rounded-full" %>
      </div>

      <div class="flex-1 min-w-0">
        <!-- Extend touch target to entire panel -->
        <span class="absolute inset-0" aria-hidden="true"></span>

        <p class="text-sm font-medium text-gray-900"><%= contact.display_name %></p>

        <p class="text-sm text-gray-500 truncate">
          <% if !contact.phone.blank? %>
            <%= ui_icon(:phone, classes: "inline-flex h-4 w-4") %>
            <%= contact.phone %>
          <% else %>
            <%= ui_icon(:envelope, classes: "inline-flex h-4 w-4") %>
            <%= contact.display_email %>
          <% end %>
        </p>

        <% contact.labels.each do |label| %>
          <span
            class="
              bg-purple-100 text-purple-800 text-xs font-medium px-1.5 py-0.5 rounded dark:bg-purple-900
              dark:text-purple-300
            "
          >
            <%= label.name %>
          </span>
        <% end %>
      </div>
    </div>
  </a>
</li>
