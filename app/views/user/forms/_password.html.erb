<%= form_with(model: user, id: dom_id(user), url: "password") do |form| %>
  <div>
    <div class="space-y-4">
      <%= render "shared/form_messages", resource: form, message: local_assigns[:message] %>
      <%= render "shared/form_header", title: "Change Password", subtitle: "Please fill in details to change your password." %>

      <div>
        <label for="old_password" class="block text-sm font-medium text-gray-700"> Old Password </label>

        <div class="mt-1 flex w-full" data-controller="password-toggle">
          <div class="mt-1 flex-auto w-full">
            <input
              type="password"
              name="user[original_password]"
              id="user_original_password"
              class="form-text-field"
              data-password-toggle-target="input"
              autocomplete="off"
            >
          </div>

          <i
            class="cursor-pointer fa-regular fa-eye-slash"
            data-password-toggle-target="icon"
            data-action="click->password-toggle#toggle"
            id="original_password"
            style="margin-left:-30px; margin-top:12px"
          ></i>
        </div>
      </div>

      <div>
        <label for="new_password" class="block text-sm font-medium text-gray-700"> New Password </label>

        <div class="mt-1 flex w-full" data-controller="password-toggle">
          <div class="mt-1 flex-auto w-full">
            <input
              type="password"
              name="user[new_password]"
              id="user_new_password"
              class="form-text-field"
              data-password-toggle-target="input"
              autocomplete="off"
            >
          </div>

          <i
            class="cursor-pointer fa-regular fa-eye-slash"
            data-password-toggle-target="icon"
            data-action="click->password-toggle#toggle"
            id="new_password"
            style="margin-left:-30px; margin-top:12px"
          ></i>
        </div>
      </div>

      <div>
        <label for="new_password_confirmation" class="block text-sm font-medium text-gray-700">
          New Password confirmation
        </label>

        <div class="mt-1 flex w-full" data-controller="password-toggle">
          <div class="mt-1 flex-auto w-full">
            <input
              type="password"
              id="user_new_password_confirmation"
              name="user[new_password_confirmation]"
              class="form-text-field"
              data-password-toggle-target="input"
              autocomplete="off"
            >
          </div>

          <i
            class="cursor-pointer fa-regular fa-eye-slash"
            data-password-toggle-target="icon"
            data-action="click->password-toggle#toggle"
            id="new_password_confirmation"
            style="margin-left:-30px; margin-top:12px"
          ></i>
        </div>
      </div>

      <div class="flex justify-end space-x-2">
        <%= form.submit "Save", class: "btn-primary" %>
      </div>
    </div>
  </div>
<% end %>
