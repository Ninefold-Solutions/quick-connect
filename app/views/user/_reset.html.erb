<div class="sm:rounded-lg bg-gray-50 mt-5">
  <div class="px-4 py-5 sm:p-6">
    <h3 class="text-lg leading-6 font-medium text-gray-800">Reset Account</h3>

    <div class="mt-2 text-sm text-gray-600 max-w-xl">
      <p>
        Do you wish to reset your account? This will remove all your contacts, and all of the data associated with them.
        Your account will not be deleted.
      </p>
    </div>

    <div class="mt-5 whitespace-nowrap">
      <%= confirm_button(reset_user_path, "Reset Account", "Are you sure you want to reset your account?", "inline-flex btn-secondary") %>
    </div>
  </div>
</div>

<div class="sm:rounded-lg bg-gray-50 mt-5">
  <div class="px-4 py-5 sm:p-6">
    <h3 class="text-lg leading-6 font-medium text-gray-800">Delete your account</h3>

    <div class="mt-2 text-sm text-gray-600">
      <p>Once you delete your account, you will lose all data associated with it.</p>
    </div>

    <div class="mt-5">
      <%= confirm_button(destroy_user_path, "Delete Account", "Are you sure you want to delete your account?", "inline-flex btn-red") %>
    </div>
  </div>
</div>
