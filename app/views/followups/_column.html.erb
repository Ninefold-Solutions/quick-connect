<div class="py-2 border-r border-gray-200 h-screen overflow-y-scroll overscroll-contain">
  <div class="relative">
    <div class="flex flex-wrap items-baseline px-4 py-2">
      <h3 class="text-xs font-semibold tracking-wider text-gray-500 uppercase"><%= title %></h3>
      <% if contacts %>
        <p class="mt-1 ml-1 text-sm text-gray-500 truncate">(<%= contacts.count %>)</p>
      <% end %>
    </div>
    <% if contacts %>
      <nav class="flex-1" aria-label="Directory">
        <div class="relative h-full pb-44">
          <ul role="list" class="grid grid-cols-1 px-2" id="<%= list_id %>">
            <%= render partial: "card", collection: contacts, as: :contact, cached: false %>
          </ul>
        </div>
      </nav>
    <% end %>
  </div>
</div>
