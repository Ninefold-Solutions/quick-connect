<main class="relative z-0 flex-1 overflow-x-auto focus:outline-none bg-gray-50">
  <div class="min-h-full">
    <div class="flex flex-wrap items-baseline px-6 py-4">
      <h1 class="text-3xl font-bold leading-tight text-gray-900">Follow Ups</h1>
    </div>
    <div class="grid grid-cols-6 md:grid-cols-6 lg:grid-cols-6 md:grid border-t px-1 border-gray-200">
      <%= render partial: "column", locals: { title: "In 7 days", contacts: @first, list_id: "first" } %>
    
      <%= render partial: "column", locals: { title: "In 15 days", contacts: @second, list_id: "second" } %>
  
      <%= render partial: "column", locals: { title: "In 30 days", contacts: @third, list_id: "third" } %>
      <%= render partial: "column", locals: { title: "In 60 days", contacts: @fourth, list_id: "fourth" } %>
      <%= render partial: "column", locals: { title: "In 90 days", contacts: @fifth, list_id: "fifth" } %>
      <%= render partial: "column", locals: { title: "In 100 days", contacts: @sixth, list_id: "sixth" } %>
    </div>
  </div>
</main>
