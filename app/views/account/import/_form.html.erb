<%= form_with(model: Contact, url: "#{import_contacts_path}", method: :post) do |form| %>
  <% if local_assigns[:messages] && defined?(messages) && !messages.nil? %>
    <div class="p-4 mb-4 rounded bg-red-50" id="error_explanation">
      <div class="flex">
        <div class="flex-shrink-0">
          <!-- Heroicon name: solid/x-circle -->
          <i class="fa-solid fa-circle-xmark w-5 h-5 text-red-400" aria-hidden="true"></i>
        </div>

        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            1 error prohibited this csv from being imported:
          </h3>

          <div class="mt-2 text-sm text-red-700">
            <ul class="pl-1 space-y-1 pt-1">
              <li><%= messages %></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="space-y-4">
    <%= render "shared/form_header", title: "Import Contacts", subtitle: "Import contacts from your account in csv format" %>

    <div>
      <a
        href="/<%= current_user.account.id %>/account/import.csv"
        class="btn-inline-blue hover:underline justify-end flex mb-2"
      >
        Export Sample CSV
      </a>

      <button
        type="button"
        class="
          relative block w-full rounded-lg border-2 border-dashed border-gray-300 p-12 text-center
          hover:border-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2
        "
        data-controller="file-input"
      >
        <input
          type="file"
          class="absolute overflow-hidden top-0 left-0 w-full h-full"
          style=" cursor: pointer;opacity: 0; z-index: 2;"
          accept="text/csv"
          name="contact[filename]"
          onchange="this.form.requestSubmit()"
          data-action="change->file-input#update"
          id="contact_filename"
        >

        <%= form.file_field :picture, class: "hidden" %>

        <i class="fa-solid fa-cloud-arrow-up w-9 h-9 text-gray-400 mx-auto"></i>

        <span class="text-gray-900" id="upload" data-file-input-target="label"> Custom Upload </span>
      </button>
    </div>

    <%= form.submit "Import Contacts", class: "btn-primary  float-right my-4" %>
  </div>
<% end %>
