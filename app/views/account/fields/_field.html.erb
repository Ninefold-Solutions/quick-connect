<%= turbo_frame_tag dom_id(field) do %>
  <li class="flex py-2 border-b border-gray-200">
    <div class="flex items-center w-full ml-4">
      <p class="ml-3 font-light text-gray-600">
        <% if (icon_name = field_icon_name(field.icon)) %>
          <%= ui_icon(icon_name, classes: "h-4 w-4") %>
        <% end %>
      </p>

      <p class="w-full ml-2 text-sm font-normal text-gray-900">
        <%= field.name.upcase_first %>
      </p>

      <p class="w-full ml-2 text-sm font-normal text-gray-700">
        <%= field.protocol %>

        <div class="flex justify-end space-x-2">
          <%= edit_button(edit_account_field_path(field)) %>
          <%= delete_button(account_field_path(field)) %>
        </div>
      </p>
    </div>
  </li>
<% end %>
