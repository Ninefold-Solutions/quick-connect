<%= tailwind_form_with(model: field, id: dom_id(field), url: account_fields_path) do |form| %>
  <div class="space-y-4">
    <%= render "shared/form_messages", resource: field, message: local_assigns[:message] %>
    <%= render "shared/form_header", title: "Add New Conversation Type", subtitle: "You can define custom field which can be applied on contacts." %>
    <%= form.text_field :name, "Field Type", autocomplete: "off", class: "form-text-field" %>

    <div>
      <%= form.text_field :protocol, "Protocol (optional)", autocomplete: "off", class: "form-text-field", placeholder: "mailto:" %>

      <p class="mt-2 text-xs text-gray-500">
        Each new contact field type can be clickable. If a protocol is set, we will use it to trigger the action that is
        set.
      </p>
    </div>

    <div>
      <%= form.text_field :icon, "Icon (optional)", autocomplete: "off", class: "form-text-field", placeholder: "email, phone, website" %>

      <p class="mt-2 text-xs text-gray-500" id="question-explanation">
        You can associate an icon with this contact field type. Supported values include email, phone, website,
        linkedin, twitter, whatsapp, telegram and facebook.
      </p>
    </div>

    <!-- Hack ends here -->
    <div class="flex justify-end pb-8"><%= form.submit "Save", class: "btn-primary" %></div>
  </div>
<% end %>
