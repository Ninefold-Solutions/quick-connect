  <%= turbo_frame_tag "user_form" do %>
  <%= tailwind_form_with(model: user, id: dom_id(user), url: account_users_path) do |f| %>
    <div class="space-y-4">
      <%= render "shared/form_messages", resource: user, message: local_assigns[:message] %>
      <%= render "shared/form_header", title: "Add New User", subtitle: "Create a new user for your account. Set their password directly." %>
      <%= f.text_field :first_name, " First Name", autocomplete: "off", class: "form-text-field" %>
      <%= f.text_field :last_name, " Last Name", autocomplete: "off", class: "form-text-field" %>
      <%= f.text_field :email, "Email Address", autocomplete: "off", class: "form-text-field" %>
      <%= f.password_field :password, "Password", autocomplete: "new-password", class: "form-text-field" %>
      <div class="flex justify-end pb-8">
        <%= f.submit "Save", class: "btn-primary" %>
      </div>
    <% end %>
  </div>
<% end %>
