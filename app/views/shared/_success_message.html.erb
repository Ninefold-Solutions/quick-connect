<% if message %>
  <div class="p-4 rounded bg-green-50" data-controller="dismissable">
    <div class="flex">
      <div class="flex-shrink-0">
        <!-- Heroicon name: solid/check-circle -->
        <i class="fa-solid fa-circle-check w-5 h-5 text-green-400" aria-hidden="true"></i>
      </div>

      <div class="ml-3">
        <p class="text-sm font-medium text-green-800">
          <%= message %>
        </p>
      </div>

      <div class="hidden pl-3 ml-auto">
        <div class="-mx-1.5 -my-1.5">
          <button
            class="
              inline-flex bg-green-50 rounded p-1.5 text-green-500 hover:bg-green-100 focus:outline-none
              focus:ring-2 focus:ring-offset-2 focus:ring-offset-green-50 focus:ring-green-600
            "
          >
            <span class="sr-only">Dismiss</span>
            <!-- Heroicon name: solid/x -->
            <i class="fa-solid fa-xmark w-5 h-5" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>
