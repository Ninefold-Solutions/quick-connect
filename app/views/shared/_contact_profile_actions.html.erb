<% if !contact.phone.blank? %>
  <div>
    <button title="Send Sms" id="phone">
      <span class="icon-span"><%= ui_icon(:comments, classes: "h-5 w-5") %></span>
    </button>
  </div>
<% end %>

<% if !contact.email.blank? %>
  <div>
    <a href="mailto:<%= contact.email %>" title="Send Email">
      <span class="icon-span"><%= ui_icon(:envelope, classes: "h-5 w-5") %></span>
    </a>
  </div>
<% end %>

<a
  href="/<%= contact.account.id %>/contacts/<%= contact.id %>/timeline"
  type="button"
  class="<%= profile_button_class %>"
>
  View Profile
</a>
