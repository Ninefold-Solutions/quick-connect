<% error_resource = resource.respond_to?(:object) ? resource.object : resource %>
<% if error_resource&.errors&.any? %>
  <div class="p-4 rounded bg-red-50" id="error_explanation">
    <div class="flex">
      <div class="flex-shrink-0">
        <!-- Heroicon name: solid/x-circle -->
        <i class="fa-solid fa-circle-xmark w-5 h-5 text-red-400" aria-hidden="true"></i>
      </div>

      <div class="ml-3">
        <h3 class="text-sm font-medium text-red-800">
          <%= I18n.t("errors.messages.not_saved",
                     count: error_resource.errors.count,
                     resource: error_resource.class.model_name.human.downcase) %>
        </h3>

        <div class="mt-2 text-sm text-red-700">
          <ul class="pl-5 space-y-1">
            <% error_resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
<% end %>
