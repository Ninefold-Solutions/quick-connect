<aside class="px-2 py-4 sm:px-6 lg:py-0 lg:px-0 lg:col-span-3">
  <nav class="space-y-1">
    <a href="<%= user_profile_path %>" class="<%= current_page?(user_profile_path) ? "selected" : "unselected" %>">
      <!-- Heroicon name: outline/user-circle -->
      <i class="fa-solid fa-circle-user svg-icon h-6 inline-flex" aria-hidden="true"></i>

      <span class="truncate"> Profile </span>
    </a>

    <a
      href="<%= setting_password_path %>"
      class="<%= current_page?(setting_password_path) ? "selected" : "unselected" %>"
    >
      <!-- Heroicon name: outline/key -->
      <i class="fa-solid fa-key svg-icon h-6 inline-flex" aria-hidden="true"></i>

      <span class="truncate"> Password </span>
    </a>

    <a
      href="<%= user_preferences_path %>"
      class="<%= current_page?(user_preferences_path) ? "selected" : "unselected" %>"
    >
      <i class="fa-solid fa-building svg-icon"></i>

      <span class="truncate"> Preferences </span>
    </a>
  </nav>
</aside>
