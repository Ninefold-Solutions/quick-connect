<aside class="px-2 py-4 sm:px-6 lg:py-0 lg:px-0 lg:col-span-3">
  <nav class="space-y-1" id="menu">
    <a
      href="<%= account_relations_path %>"
      class="<%= current_page?(account_relations_path) ? "selected" : "unselected" %>"
    >
      <i class="fa-solid fa-id-card svg-icon"></i>

      <span class="truncate"> Relations </span>
    </a>

    <a href="<%= account_labels_path %>" class="<%= current_page?(account_labels_path) ? "selected" : "unselected" %>">
      <i class="fa-solid fa-tag svg-icon"></i>

      <span class="truncate"> Contact Labels </span>
    </a>

    <a
      href="<%= archived_contacts_path %>"
      class="<%= current_page?(archived_contacts_path) ? "selected" : "unselected" %>"
    >
      <!-- Heroicon name: outline/user-circle -->
      <i class="fa-solid fa-box-archive svg-icon"></i>

      <span class="truncate"> Archived Contacts </span>
    </a>

    <a href="<%= account_fields_path %>" class="<%= current_page?(account_fields_path) ? "selected" : "unselected" %>">
      <!-- Heroicon name: outline/user-circle -->
      <i class="fa-solid fa-circle-info svg-icon"></i>

      <span class="truncate"> Conversation Types </span>
    </a>

    <a
      href="<%= account_activities_path %>"
      class="<%= current_page?(account_activities_path) ? "selected" : "unselected" %>"
    >
      <!-- Heroicon name: outline/user-circle -->
      <i class="fa-solid fa-graduation-cap svg-icon"></i>

      <span class="truncate"> Activities </span>
    </a>

    <a
      href="<%= account_life_events_path %>"
      class="<%= current_page?(account_life_events_path) ? "selected" : "unselected" %>"
    >
      <!-- Heroicon name: outline/user-circle -->
      <i class="fa-regular fa-calendar svg-icon"></i>

      <span class="truncate"> Life Events </span>
    </a>

    <a
      href="<%= untracked_contacts_path %>"
      class="<%= current_page?(untracked_contacts_path) ? "selected" : "unselected" %>"
    >
      <!-- Heroicon name: outline/user-circle -->
      <i class="fa-solid fa-magnifying-glass-minus svg-icon"></i>

      <span class="truncate"> Untracked Contacts </span>
    </a>

    <% if current_user.account.owner_id == current_user.id %>
      <a href="<%= account_users_path %>" class="<%= current_page?(account_users_path) ? "selected" : "unselected" %>">
        <!-- Heroicon name: outline/user-circle -->
        <i class="fa-solid fa-circle-user svg-icon" aria-hidden="true"></i>

        <span class="truncate"> Users </span>
      </a>
    <% end %>

    <a
      href="<%= account_import_contacts_path %>"
      class="<%= current_page?(account_import_contacts_path) ? "selected" : "unselected" %>"
    >
      <!-- Heroicon name: outline/user-circle -->
      <i class="fa-solid fa-file-import svg-icon"></i>

      <span class="truncate"> Import Contacts </span>
    </a>
  </nav>
</aside>
