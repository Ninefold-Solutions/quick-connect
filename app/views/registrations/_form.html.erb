<%= turbo_frame_tag "sign_up_form", target: "_top" do %>
  <%= form_with(model: resource, url: signup_path, scope: :user) do |f| %>
    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md" data-controller="toggle">
      <%= render "shared/error_messages", resource: resource %>

      <div class="px-4 py-8 space-y-4 bg-white shadow sm:rounded-lg sm:px-10">
        <div class="flex">
          <div>
            <label for="user_first_name" class="block text-sm font-medium text-gray-700"> First Name </label>

            <div class="mt-1">
              <%= f.text_field :first_name, autofocus: true, autocomplete: "off", class: "form-text-field" %>
            </div>
          </div>

          <div class="ml-2">
            <label for="user_last_name" class="block text-sm font-medium text-gray-700"> Last Name </label>

            <div class="mt-1">
              <%= f.text_field :last_name, autofocus: true, autocomplete: "off", class: "form-text-field" %>
            </div>
          </div>
        </div>

        <div>
          <label for="user_email" class="block text-sm font-medium text-gray-700"> Email Address </label>

          <div class="mt-1">
            <%= f.email_field :email, autofocus: true, autocomplete: "off", class: "form-text-field" %>
          </div>
        </div>

        <div>
          <label for="user_password" class="block text-sm font-medium text-gray-700"> Password </label>
          <em>(6 characters minimum)</em>

          <div class="mt-1 flex w-full" data-controller="password-toggle">
            <div class="mt-1 flex-auto w-full">
              <input
                type="password"
                name="user[password]"
                id="user_password"
                class="form-text-field"
                autocomplete="new-password"
                data-password-toggle-target="input"
              >
            </div>

            <span
              class="cursor-pointer text-gray-500"
              data-password-toggle-target="icon"
              data-action="click->password-toggle#toggle"
              id="togglePassword"
              style="margin-left:-30px; margin-top:12px"
            >
              <%= ui_icon(:eye_slash, classes: "h-5 w-5") %>
            </span>
          </div>
        </div>

        <div>
          <label for="user_password_confirmation" class="block text-sm font-medium text-gray-700">
            Password Confirmation
          </label>

          <div class="mt-1 flex w-full" data-controller="password-toggle">
            <div class="mt-1 flex-auto w-full">
              <input
                type="password"
                name="user[password_confirmation]"
                id="user_password_confirmation"
                class="form-text-field"
                autocomplete="new-password"
                data-password-toggle-target="input"
              >
            </div>

            <span
              class="cursor-pointer text-gray-500"
              data-password-toggle-target="icon"
              data-action="click->password-toggle#toggle"
              id="togglePasswordConfirmation"
              style="margin-left:-30px; margin-top:12px"
            >
              <%= ui_icon(:eye_slash, classes: "h-5 w-5") %>
            </span>
          </div>
        </div>

        <div class="actions mt-6">
          <%= f.submit "Sign Up", class: "cursor-pointer w-full flex justify-center py-2 px-4 border border-transparent rounded shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
      </div>

      <div class="text-sm text-center pt-4">
        <a href="<%= login_path %>" class="font-medium text-indigo-600 hover:text-indigo-500 hover:underline">
          Log in
        </a>
      </div>
    </div>
  <% end %>
<% end %>
