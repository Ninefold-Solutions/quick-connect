<div class="flex flex-col pt-5 pb-4 border-r border-gray-200">
  <div class="flex flex-col flex-1 w-64 h-0 overflow-y-auto">
    <div class="relative inline-block px-3 text-left">
      <nav class="px-3">
        <div>
          <h3 class="text-xs font-semibold tracking-wider text-gray-500 uppercase" id="teams-headline">
            Filter Groups
          </h3>

          <%= form_with url: batches_reports_path, method: :get do |form| %>
            <main class="max-w-lg pt-4 pb-12 mx-auto space-y-4 lg:pb-16">
              <div>
                <%= form.label :bucket, "Bucket", class: "block text-sm font-medium text-gray-700" %>
                <%= select_tag :bucket, options_for_select(Batch.buckets.map { |k, v| [k.humanize.capitalize, k] }, (params["bucket"] unless params["bucket"].blank?)), class: "form-text-field", :name => "bucket", :prompt => "Select Bucket" %>
              </div>

              <div class="flex justify-end mt-6 space-x-2">
                <%= link_to "Reset", batches_reports_path, class: "btn-secondary" %>
                <%= form.submit "Search", class: "btn-primary" %>
              </div>
            </main>
          <% end %>
        </div>
      </nav>
    </div>
  </div>
</div>
