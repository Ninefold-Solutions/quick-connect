<% if policy(contact).profile? %>
  <% links = contact.links %>
  <% contact = contact.decorate %>
  <div class="h-full">
    <div
      id="modal1"
      data-controller="click-outside"
      data-action="keyup@document->modal#escClose click:outside->modal#close "
    ></div>

    <div>
      <img
        class="h-16 w-full object-cover lg:h-32"
        src="https://images.unsplash.com/photo-1444628838545-ac4016a5418a?ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80"
        alt=""
      >
    </div>

    <div class="xl:px-8 md:px-6" id="contact-header">
      <div class="-mt-12 sm:-mt-16 sm:flex sm:items-end sm:space-x-5">
        <div class="flex">
          <%= image_tag "male-placeholder-image.png", alt: "", class: "h-20 w-20 rounded-full ring-4 ring-white sm:h-32 sm:w-32" %>
        </div>

        <div class="sm:flex-1 sm:min-w-0 sm:flex sm:items-center justify-end lg:space-x-2">
          <div class="sm:hidden 2xl:block mt-4 min-w-0 flex-1">
            <h1 class="text-2xl font-bold text-gray-900 truncate"><%= contact.display_name %></h1>
          </div>

          <div class="flex flex-col justify-stretch space-y-1 sm:flex-row sm:space-y-0 space-x-2">
            <%= render "shared/contact_follow_up_badge", follow_up_text: contact.display_follow_up_after %>

            <%= render "shared/contact_social_links", contact: contact, links: links, links_container_class: "inline-flex space-x-2 pl-1" %>

            <%= render "shared/contact_profile_actions", contact: contact, profile_button_class: "inline-flex btn-secondary whitespace-nowrap" %>
          </div>
        </div>
      </div>

      <div class="hidden sm:block 2xl:hidden mt-4 min-w-0 flex-1">
        <h1 class="text-2xl font-bold text-gray-900"><%= contact.display_name %></h1>
      </div>
    </div>

    <div class="py-2 xl:px-8 md:px-6 mx-auto flex">
      <% if contact.intro? %>
        <p class="text-sm font-medium text-gray-500" style="flex-shrink: 2 ">
          <%= contact.intro.upcase_first %>
        </p>
      <% end %>
    </div>

    <!-- Tabs -->
    <div class="mt-6 sm:mt-2 2xl:mt-5">
      <div class="border-b border-gray-200">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <nav class="-mb-px flex space-x-8" aria-label="Tabs">
            <!-- Current: "border-indigo-500 text-gray-900", Default: "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300" -->
            <span
              class="border-indigo-500 text-gray-900 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm"
              aria-current="page"
            >
              Profile
            </span>
          </nav>
        </div>
      </div>
    </div>

    <!-- Description list -->
    <div class="mt-6 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <dl class="grid grid-cols-1 gap-x-4 gap-y-8 sm:grid-cols-3">
        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Phone</dt>

          <% if !contact.phone.blank? %>
            <dd class="mt-1 text-sm text-gray-900"><%= contact.phone %></dd>
          <% else %>
            <dd class="text-xs font-normal text-gray-500 mt-1">-</dd>
          <% end %>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Email</dt>

          <% if !contact.email.blank? %>
            <dd class="mt-1 text-sm text-gray-900 break-words"><%= contact.display_email %></dd>
          <% else %>
            <dd class="text-xs font-normal text-gray-500 mt-1">-</dd>
          <% end %>
        </div>
      </dl>
    </div>

    <!-- Team member list -->
    <div class="mt-8 max-w-5xl mx-auto px-4 pb-12 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 gap-16">
        <div class="grid grid-cols-1 col-span-2">
          <div>
            <h2 class="text-sm font-medium text-gray-500 pb-2">Last Activities</h2>

            <ul class="mt-1">
              <% contact.events.order(created_at: :desc).limit(5).each do |event| %>
                <% if lookup_context.template_exists?(event.action, "contact/timeline", true, formats: [:html]) %>
                  <% cache event do %>
                    <%= render partial: "contact/timeline/#{event.action}", locals: { event: event }, formats: [:html], layout: false %>
                  <% end %>
                <% end %>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
