<% contact = contact.decorate %>

<li
  id="<%= dom_id(contact) %>"
  class="hover:bg-gray-50 focus-within:ring-2 focus-within:ring-inset focus-within:ring-indigo-500 <%= "bg-gray-200" if params[:id].present? && params[:id].to_i == contact.id %>"
>
  <a href="<%= contacts_path(id: contact) %>" class="block">
    <div
      class="relative cursor-pointer px-2 py-3 flex items-center space-x-3"
      id="show"
      data-contact-id="<%= contact.id %>"
    >
      <div class="flex-shrink-0">
        <%= image_tag "male-placeholder-image.png", class: "w-10 h-10 rounded-full" %>
      </div>

      <div class="flex-1 min-w-0">
        <!-- Extend touch target to entire panel -->
        <span class="absolute inset-0" aria-hidden="true"></span>

        <p class="text-sm font-medium text-gray-900"><%= contact.display_name %></p>

        <p class="text-sm text-gray-500 truncate">
          <% if !contact.phone.blank? %>
            <i class="fa-solid fa-phone inline-flex" style="font-size: .8rem"></i>
            <%= contact.phone %>
          <% else %>
            <i class="fa-solid fa-envelope inline-flex" style="font-size: .8rem" aria-hidden="true"></i>
            <%= contact.display_email %>
          <% end %>
        </p>
      </div>
    </div>
  </a>
</li>
