<% contact = contact.decorate %>
<tr>
  <td class="w-full table-cell whitespace-nowrap">
    <div class="flex items-center">
      <div class="flex-1 min-w-0 sm:flex sm:items-center sm:justify-between">
        <div>
          <a href="<%= contact_about_index_path(contact) %>" class="truncate hover:text-gray-600 hover:underline">
            <div class="flex text-sm font-medium text-gray-600 truncate">
              <p> <%= contact.display_name %></p>
            </div>
          </a>
          <div class="flex-1 w-full mt-2">
            <div class="flex items-center text-sm text-gray-500">
              <!-- Heroicon name: solid/calendar -->
              <i class="fa-solid fa-calendar flex-shrink-0 mr-1.5 h-5 w-5 text-gray-400" aria-hidden="true"></i>
              <p>
                Archived on
                <%= contact.display_archived_on %>
              </p>
            </div>
          </div>
        </div>
      </div>
    </td>
    <td class="table-cell whitespace-nowrap">
      <div class="flex justify-end space-x-2">
        <%= link_to "Restore", unarchive_contact_path(contact), class: "btn-inline-edit mr-2" %>
        <%= delete_button(contact_path(contact, script_name: "/#{contact.account.id}")) %>
      </div>
    </div>
  </td>
</tr>
