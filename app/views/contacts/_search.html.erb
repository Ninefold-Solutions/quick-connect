<div
  class="flex-1 min-w-0"
  data-behavior="autocomplete"
  data-controller="nav-search"
  data-nav-search-url-value="/search/contacts"
>
  <label for="search" class="sr-only">Search</label>

  <div class="relative rounded shadow-sm">
    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
      <!-- Heroicon name: solid/search -->
      <i class="fa-solid fa-magnifying-glass h-5 w-5 text-gray-400" aria-hidden="true"></i>
    </div>

    <input
      type="search"
      name="search"
      id="search"
      class="block w-full pl-10 form-text-field"
      placeholder="Search"
      autocomplete="off"
      data-nav-search-target="input"
    >
  </div>

  <div class="relative">
    <div
      class="absolute left-0 z-10 block w-full mt-2 origin-top-right bg-white rounded shadow-lg focus:outline-none"
      role="menu"
      aria-orientation="vertical"
      aria-labelledby="options-menu"
    >
      <ul data-nav-search-target="results"></ul>
    </div>
  </div>
</div>
